#!/usr/bin/env python3
"""
ssh-1password-wrapper — Run an SSH command with a key fetched on-demand from 1Password CLI.

Usage:
	ssh-1password-wrapper [ssh-arguments]
	CAREFREE_SSH_KEY_SOURCE=op://... ssh-1password-wrapper [ssh-arguments]

The key reference is controlled by the CAREFREE_SSH_KEY_SOURCE environment variable.
Defaults to the edge node key. Set to CORE to use the core gateway key.

Examples:
	ssh-1password-wrapper carefree@100.67.6.63
	CAREFREE_SSH_KEY_SOURCE=core ssh-1password-wrapper carefree@100.67.244.157
"""

import subprocess
import sys
import os
import tempfile
import stat

EDGE_KEY_REF = "op://Carefree DevOps/Carefree Edge Nodes SSH Key/private key"
CORE_KEY_REF = "op://Carefree DevOps/Carefree Servers SSH Key/private key"


def resolve_key_ref() -> str:
	source = os.environ.get("CAREFREE_SSH_KEY_SOURCE", "").lower()
	if source in ("core", "server", "servers"):
		return CORE_KEY_REF
	if source.startswith("op://"):
		return source
	return EDGE_KEY_REF


def fetch_key(key_ref: str) -> bytes:
	result = subprocess.run(
		["op", "read", key_ref],
		capture_output=True,
	)
	if result.returncode != 0:
		err = result.stderr.decode(errors="replace").strip()
		print(
			f"ERROR: Failed to read SSH key from 1Password.\n"
			f"  Key reference: {key_ref}\n"
			f"  op error: {err}\n"
			f"  Is 1Password unlocked? Run: op signin",
			file=sys.stderr,
		)
		sys.exit(1)
	return result.stdout


def main() -> None:
	if not sys.argv[1:]:
		print(__doc__, file=sys.stderr)
		sys.exit(1)

	key_ref = resolve_key_ref()
	key_data = fetch_key(key_ref)

	# Write key to a secured temp file — deleted in finally block
	fd, tmp_path = tempfile.mkstemp(suffix=".pem", prefix="op-ssh-")
	try:
		os.write(fd, key_data)
		os.close(fd)
		os.chmod(tmp_path, stat.S_IRUSR | stat.S_IWUSR)  # 0o600

		ssh_cmd = ["ssh", "-i", tmp_path, "-o", "IdentitiesOnly=yes"] + sys.argv[1:]
		proc = subprocess.run(ssh_cmd)
		sys.exit(proc.returncode)
	finally:
		try:
			os.unlink(tmp_path)
		except OSError:
			pass


if __name__ == "__main__":
	main()
